static func item(original: String, index: int = -1) -> String:
	return ITEMS.get(original.to_lower(), "Peça %d (nome pendente)" % (index + 1))

static func clip(original: String, index: int = -1) -> String:
	var key := original.get_file().to_lower()
	var suffix := ""
	for variant in ["_root_motion", "_rootmotion", "_rm", "_in_place", "_inplace"]:
		if key.ends_with(variant):
			key = key.trim_suffix(variant)
			suffix = " — com deslocamento" if variant in ["_root_motion", "_rootmotion", "_rm"] else " — no lugar"
			break
	return str(CLIPS.get(key, "Movimento %d (nome pendente)" % (index + 1))) + suffix

static func pack(original: String) -> String:
	match original:
		"ual1-standard": return "Biblioteca de animações 1"
		"ual2-standard": return "Biblioteca de animações 2"
		"rpg_items_pack": return "Itens de RPG"
		"medieval_weapons_pack": return "Armas medievais"
		"survival_pack": return "Sobrevivência"
		"house_interior_pack": return "Mobiliário"
		"medieval_village_pack": return "Vila medieval"
		"nature_pack": return "Natureza"
	return "Coleção"

static func scene(record: Dictionary, index: int) -> String:
	var path := str(record.get("sourcePath", "")).to_lower()
	var variant := "variante %d" % (index + 1)
	if "no root" in path or "noroot" in path or "in place" in path or "inplace" in path or "no_root" in path:
		variant = "sem deslocamento"
	elif "root" in path:
		variant = "com deslocamento"
	return "%s — %s" % [pack(str(record.get("pack", ""))), variant]

static func bone(original: String, index: int) -> String:
	var key := original.to_lower().get_slice(":", original.count(":"))
	key = key.trim_prefix("mixamorig").trim_prefix("def-").trim_prefix("bip001")
	var side := ""
	for part in ["left", "right"]:
		if key.begins_with(part):
			side = " (esq.)" if part == "left" else " (dir.)"
			key = key.trim_prefix(part)
			break
		if key.ends_with(part):
			side = " (esq.)" if part == "left" else " (dir.)"
			key = key.trim_suffix(part)
			break
	if side.is_empty():
		for sep in ["_", ".", "-"]:
			if key.ends_with(sep + "l") or key.ends_with(sep + "r"):
				side = " (esq.)" if key.ends_with("l") else " (dir.)"
				key = key.left(-2)
				break
	key = key.replace("_", "").replace("-", "").replace(".", "").replace(" ", "")
	var terminal := ""
	if key.ends_with("leaf"):
		key = key.trim_suffix("leaf")
		terminal = " (extremidade)"
	if BONES.has(key):
		return str(BONES[key]) + side + terminal
	for finger in ["thumb", "index", "middle", "ring", "pinky", "little"]:
		var normalized := key.trim_prefix("hand")
		if normalized.begins_with(finger):
			var digit := normalized.trim_prefix(finger)
			if digit.is_valid_int():
				return "%s %d%s%s" % [BONES[finger], int(digit), side, terminal]
	return "Osso %d (nome pendente)%s" % [index + 1, side]
